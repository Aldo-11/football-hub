# Copia este archivo a .env (nunca subas .env al repositorio)
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB (local o Atlas)
MONGO_URI=mongodb://localhost:27017/footballhub

# JWT: obligatorios en producción, mínimo 32 caracteres cada uno.
# Genera valores con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Opcionales
# SEASON_START_YEAR=2026        # fija la temporada (por defecto se calcula con la fecha)
# EXTERNAL_API_TIMEOUT_MS=8000  # timeout de las llamadas a ESPN
# AUTH_RATE_LIMIT_MAX=10        # intentos de login/registro por IP cada 15 min
# API_RATE_LIMIT_MAX=120        # peticiones por IP por minuto
# ENABLE_CRON=true              # resolución automática de pronósticos
# TRUST_PROXY=1                 # proxies delante de la app (por defecto 1 en producción)
