PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Base de Datos
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Fuentes de Fútbol
# Fuente principal: football-data.org (Token gratuito en https://www.football-data.org/client/register)
FOOTBALL_DATA_KEY=tu_token_de_football_data_org

# Fuente secundaria: API-Football (RapidAPI)
RAPIDAPI_KEY=tu_rapidapi_key
RAPIDAPI_HOST=sportapi7.p.rapidapi.com

# Autenticación JWT
JWT_ACCESS_SECRET=clave_secreta_access_token_minimo_32_caracteres
JWT_REFRESH_SECRET=clave_secreta_refresh_token_minimo_32_caracteres

# Noticias (Opcionales con fallback)
NEWSAPI_KEY=tu_newsapi_key
GNEWS_KEY=tu_gnews_key
