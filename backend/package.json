{
  "name": "football-hub-backend",
  "version": "1.0.0",
  "description": "Football Hub - backend (BFF) con lógica de análisis propia",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:e2e": "jest --runInBand --config jest.e2e.config.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.10.1",
    "node-cron": "^4.2.1",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0",
    "eslint": "^9.20.0",
    "@eslint/js": "^9.20.0",
    "globals": "^15.14.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/unit/**/*.test.js",
      "**/tests/api/**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ],
    "collectCoverageFrom": [
      "domain/**/*.js",
      "services/**/*.js",
      "controllers/**/*.js",
      "middleware/**/*.js",
      "jobs/**/*.js",
      "utils/**/*.js",
      "config/season.js",
      "config/clubs.js"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
